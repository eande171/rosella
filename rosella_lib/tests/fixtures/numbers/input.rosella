/* Text To Numbers */
print(number("5") + 1, " ", number("-5") * 2, " ", number("007"), " ", number("08") + number("09"));
print(number("2147483647"), " ", number("-2147483647"), " ", number("0"), " ", number("-0"));

/* Not Numbers */
print(number("abc"), number(""), number("1.5"), number("5 6"), number("- 5"), number("+5"), number("--5"), number("-"));

/* Spaces Trimmed */
print(number(" 5"), " ", number("5 "), " ", number("  -5  "), " ", number("\t7\t"), " ", number(" "));
print(number("2147483648"), number("99999999999"), number("12a"), number("a (b) & c!"));

/* Checks */
fn describe(str text) {
    if is_number(text) {
        print("[", text, "] is a number: ", number(text));
    } else {
        print("[", text, "] is not a number");
    }
}
describe("42");
describe("-42");
describe("0012");
describe(" 42 ");
describe("4 2");
describe("four");
describe("");
describe("50%");
describe("!x!");
describe(";5");

/* Arguments */
let int total = 0;
let int i = 1;
while i <= arg_count() {
    if is_number(arg(i)) { total = total + number(arg(i)); }
    i = i + 1;
}
print("total of the number arguments: ", total);

/* Asking Again */
let str answer = read("");
let int tries = 0;
while !is_number(answer) && tries < 3 {
    tries = tries + 1;
    answer = "7";
}
print("answer ", number(answer), " after ", tries, " retry");

/* Combined Conditions */
if is_number("1") && !is_number("x") && number("3") == 3 { print("combined"); }
for int n in range(0, number("3")) { print("n ", n); }
fn int doubled(str text) { return number(text) * 2; }
print(doubled("21"), " ", doubled("oops"));
exit(number("4"));
