let str name = output("git", "-c", "fixture.name=Hello & 50% (done)", "config", "--get", "fixture.name");
print("name: ", name);

/* Only The First Line */
let str first = output("git", "-c", "a.b=1", "-c", "a.c=2", "config", "--get-regexp", "^a[.]");
print("first line: ", first);

if output("git", "config", "--file", "missing.cfg", "--get", "x.y") == "" { print("empty output"); }
print("inline: ", output("git", "-c", "x.y=inline", "config", "--get", "x.y"));

fn str setting(str key) {
    return output("git", "-c", concat(key, "=from a function"), "config", "--get", key);
}
print(setting("demo.key"));
